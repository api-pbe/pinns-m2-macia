% ------------------------------------------------- document metadata
% \coursemeta{pdftitle}{running header tail}{pdfkeywords}
\newcommand{\coursemeta}[3]{%
  \hypersetup{
    pdftitle={#1},
    pdfauthor={Paul Boureau (AGM, CY Cergy Paris University)},
    pdfsubject={M2 MACIA --- Physics-Informed Neural Networks for PDEs},
    pdfkeywords={#3}}%
  \pagestyle{fancy}\fancyhf{}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \lhead{\small\textsc{\color{coursgrey} P.~Boureau \ \textbullet\ PINNs for PDEs \ \textbullet\ #2}}%
  \rhead{\small\color{coursgrey}\thepage}%
}

% \coursetitle{kicker}{big title}{optional subtitle}
\newcommand{\coursetitle}[3]{%
\begin{center}
{\color{coursgrey}\scshape\small M2 MACIA \quad\textbullet\quad Physics-Informed Neural Networks for PDEs}

\vspace{6pt}
{\color{coursteal}\rule{\textwidth}{1.2pt}}
\vspace{10pt}

{\LARGE\bfseries #1}

\vspace{8pt}
{\LARGE #2}

\ifx\relax#3\relax\else\vspace{6pt}{\large\itshape #3}\fi

\vspace{12pt}
{\color{coursteal}\rule{\textwidth}{0.4pt}}

\vspace{12pt}
{\large Paul Boureau}

\vspace{4pt}
{\color{coursgrey}\small AGM \ \textbullet\ CY Cergy Paris University}
\end{center}
}

% ------------------------------------------------- theorem environments
\theoremstyle{plain}
\ifcourse@flat
  \newtheorem{theorem}{Theorem}
  \newtheorem{proposition}[theorem]{Proposition}
  \newtheorem{lemma}[theorem]{Lemma}
  \newtheorem{corollary}[theorem]{Corollary}
  \theoremstyle{definition}
  \newtheorem{definition}{Definition}
  \newtheorem{example}{Example}
  \newtheorem{algorithm}{Algorithm}
  \theoremstyle{remark}
  \newtheorem{remark}{Remark}
\else
  \newtheorem{theorem}{Theorem}[section]
  \newtheorem{proposition}[theorem]{Proposition}
  \newtheorem{lemma}[theorem]{Lemma}
  \newtheorem{corollary}[theorem]{Corollary}
  \theoremstyle{definition}
  \newtheorem{definition}[theorem]{Definition}
  \newtheorem{example}[theorem]{Example}
  \newtheorem{algorithm}[theorem]{Algorithm}
  \theoremstyle{remark}
  \newtheorem{remark}[theorem]{Remark}
\fi
\theoremstyle{definition}
\newtheorem{exercise}{Exercise}
\newtheorem{task}{Task}
\renewcommand{\proofname}{\normalfont\scshape Proof}

