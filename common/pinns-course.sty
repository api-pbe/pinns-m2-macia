% ------------------------------------------------- boxes
\newtcolorbox{plainbox}[1][]{
  breakable, enhanced, colback=coursbg, colframe=coursteal,
  boxrule=0pt, leftrule=2pt, arc=0pt, outer arc=0pt,
  left=10pt, right=10pt, top=8pt, bottom=8pt, #1}
\newtcolorbox{warnbox}[1][]{
  breakable, enhanced, colback=coursbg, colframe=courswine,
  boxrule=0pt, leftrule=2pt, arc=0pt, outer arc=0pt,
  left=10pt, right=10pt, top=8pt, bottom=8pt, #1}
\newtcolorbox{setting}[1][]{
  breakable, enhanced, colback=coursbg, colframe=coursteal,
  boxrule=0pt, leftrule=2pt, arc=0pt, outer arc=0pt,
  left=10pt, right=10pt, top=8pt, bottom=8pt,
  title={\color{coursteal}\scshape\footnotesize What you need for this part},
  fonttitle=\normalfont, coltitle=coursteal,
  attach title to upper={\par\vspace{4pt}}, #1}
\newenvironment{keybox}{\begin{plainbox}}{\end{plainbox}}
\newenvironment{keyboxwine}{\begin{warnbox}}{\end{warnbox}}

