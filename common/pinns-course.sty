% =====================================================================
%  pinns-course.sty — shared style for
%  "Physics-Informed Neural Networks for PDEs", M2 MACIA
%  Paul Boureau — AGM, CY Cergy Paris University
%
%  Options
%    flat   theorem family numbered continuously (problem classes, labs)
%           default: numbered within sections (lecture notes)
%
%  Solutions switch
%    Compiling with \def\StudentBuild{} before \input sets \solutionsfalse,
%    so that  \ifsolutions ... \fi  blocks are dropped. See the Makefile.
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pinns-course}[2026/10/09 PINNs for PDEs course style]

\newif\ifcourse@flat \course@flatfalse
\DeclareOption{flat}{\course@flattrue}
\DeclareOption*{\PackageWarning{pinns-course}{Unknown option '\CurrentOption'}}
\ProcessOptions\relax

% ------------------------------------------------- solutions switch
\newif\ifsolutions
\ifdefined\StudentBuild \solutionsfalse \else \solutionstrue \fi

